# =========================================================================
# FailoverLab Environment Configuration Template (.env.example)
# Copy to .env for local adjustments. Safe defaults are provided.
# =========================================================================

# Shared Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Database Names
CONTROLLER_DB_NAME=failover_controller
REGION_A_DB_NAME=failover_region_a
REGION_B_DB_NAME=failover_region_b

# Internal Authentication Secret (Controller <-> Gateway / Regional Services)
INTERNAL_API_SECRET=internal-secret-token

# Published Host Ports
FRONTEND_PORT=3000
GATEWAY_PORT=8080
CONTROLLER_PORT=8000
REGION_A_PORT=8001
REGION_B_PORT=8002
REPLICATOR_PORT=8003
CONTROLLER_DB_PORT=5434
REGION_A_DB_PORT=5432
REGION_B_DB_PORT=5433

# Controller Safety Policy Defaults
CONSECUTIVE_FAILURE_THRESHOLD=3
QUORUM_REQUIRED=2
QUORUM_TOTAL=3
MAX_ALLOWED_LAG_SECONDS=5.0
MAX_ALLOWED_LAG_RECORDS=100
REQUIRE_OBSERVER_CONSENSUS=true
AUTO_FAILOVER_ENABLED=false
FENCING_ENFORCED=true
WRITE_TOKEN_TTL_SECONDS=10
DNS_PROPAGATION_TIME_SECONDS=2
FALLBACK_GRACE_PERIOD_SECONDS=10

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
