# =========================================================================
# FailoverLab Environment Configuration Template (.env.example)
# Copy this file to .env for local adjustments.
# WARNING: NEVER commit a real .env file or production secrets to git.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Environment & Runtime Mode
# -------------------------------------------------------------------------
# Set to 'development', 'staging', or 'production'.
# When set to 'production', strict authentication is ALWAYS enforced.
ENVIRONMENT=development

# When true, downstream services synthesize responses if offline.
# For full multi-region live execution, keep this set to false.
SIMULATION_MODE=false

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# -------------------------------------------------------------------------
# 2. Authentication & Access Control
# -------------------------------------------------------------------------
# Authentication mode for administrative control plane operations:
# - development: set to false for frictionless local interactive testing.
# - production: set to true (or environment=production automatically enforces it).
REQUIRE_ADMIN_AUTH=false

# Dedicated administrative secret for privileged control plane endpoints:
# (Failover promotion, failback, reset, safety policies, chaos simulation)
# Callers must provide: 'X-Admin-Secret: <secret>' or 'Authorization: Bearer <secret>'.
#
# IMPORTANT FOR PRODUCTION: Replace with a cryptographically secure token:
#   e.g. openssl rand -hex 32
ADMIN_API_SECRET=dev-admin-secret-token

# Internal inter-service secret for private Gateway-to-Controller telemetry export:
# Kept strictly separate from public operator credentials; never exposed to frontend.
#
# IMPORTANT FOR PRODUCTION: Replace with a cryptographically secure token:
#   e.g. openssl rand -hex 32
INTERNAL_API_SECRET=dev-internal-secret-token

# -------------------------------------------------------------------------
# 3. PostgreSQL Database Credentials
# -------------------------------------------------------------------------
POSTGRES_USER=postgres

# PostgreSQL database password:
# LOCAL DEVELOPMENT DEFAULT ONLY:
# In staging/production, provide a strong, high-entropy password (minimum 16 chars).
POSTGRES_PASSWORD=devpostgrespassword

# Database Names
CONTROLLER_DB_NAME=failover_controller
REGION_A_DB_NAME=failover_region_a
REGION_B_DB_NAME=failover_region_b
REGION_C_DB_NAME=failover_region_c
REGION_D_DB_NAME=failover_region_d
REGION_E_DB_NAME=failover_region_e

# -------------------------------------------------------------------------
# 4. Service Ports
# -------------------------------------------------------------------------
# Public Entry Point (Frontend SPA & Reverse Proxy via Nginx):
FRONTEND_PORT=3000

# Internal Service Ports (In compose.yaml, bound strictly to 127.0.0.1 for local dev):
GATEWAY_PORT=8080
CONTROLLER_PORT=8000
REGION_A_PORT=8001
REGION_B_PORT=8002
REGION_C_PORT=8004
REGION_D_PORT=8005
REGION_E_PORT=8006
REPLICATOR_PORT=8003

# Internal Database Ports (Bound strictly to 127.0.0.1 for local dev debugging):
CONTROLLER_DB_PORT=5434
REGION_A_DB_PORT=5432
REGION_B_DB_PORT=5433
REGION_C_DB_PORT=5435
REGION_D_DB_PORT=5436
REGION_E_DB_PORT=5437

# -------------------------------------------------------------------------
# 5. Gateway Telemetry Export Settings
# -------------------------------------------------------------------------
# Enables one-second periodic telemetry aggregation & export from Gateway to Controller:
TELEMETRY_EXPORT_ENABLED=true
TELEMETRY_EXPORT_INTERVAL_SECONDS=1.0

# Bounded queue capacity for telemetry batches during Controller connection dips:
TELEMETRY_QUEUE_CAPACITY=100

# Maximum consecutive retry attempts before dropping a failed batch:
TELEMETRY_MAX_RETRIES=5

# -------------------------------------------------------------------------
# 6. Controller Safety Policy Defaults
# -------------------------------------------------------------------------
CONSECUTIVE_FAILURE_THRESHOLD=3
QUORUM_REQUIRED=2
QUORUM_TOTAL=3
MAX_ALLOWED_LAG_SECONDS=5.0
MAX_ALLOWED_LAG_RECORDS=100
REQUIRE_OBSERVER_CONSENSUS=true
AUTO_FAILOVER_ENABLED=false
FENCING_ENFORCED=true
WRITE_TOKEN_TTL_SECONDS=10
DNS_PROPAGATION_TIME_SECONDS=2
FALLBACK_GRACE_PERIOD_SECONDS=10
