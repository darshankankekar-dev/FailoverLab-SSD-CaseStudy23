# =========================================================================
# FailoverLab: Multi-Region Active-Passive Failover Simulation
# Production Environment Variable Template (.env.production.example)
# =========================================================================
# Academic Architecture:
# Mumbai (Region A) and Singapore (Region B) run as logical regional microservices
# inside isolated Docker containers on a single Ubuntu cloud VM.
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production:
#    cp .env.production.example .env.production
# 2. Generate strong cryptographically secure values using:
#    openssl rand -hex 32
# 3. Fill in the values below. DO NOT COMMIT .env.production TO GIT!
# =========================================================================

# Frontend Loopback Host Port (Bound strictly to 127.0.0.1:3000 on host)
FRONTEND_PORT=3000

# =========================================================================
# MANDATORY SECRETS (Required by compose.prod.yaml)
# Docker Compose will refuse to start if these remain unset or default!
# =========================================================================

# Database Root Password (for all three PostgreSQL containers)
# Generate with: openssl rand -base64 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24

# Inter-Microservice Authentication Secret Token
# Used between Controller, Gateway, Region Services, and Replicator
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Administrative Authentication Control
# When REQUIRE_ADMIN_AUTH=true, mutating actions (failover, failback, reset,
# policy update, and chaos injections) require X-Admin-Secret header.
REQUIRE_ADMIN_AUTH=true

# Dedicated Admin Secret (defaults to INTERNAL_API_SECRET if left blank)
ADMIN_API_SECRET=

# =========================================================================
# Database Names
# =========================================================================
CONTROLLER_DB_NAME=failover_controller
REGION_A_DB_NAME=failover_region_a
REGION_B_DB_NAME=failover_region_b

# =========================================================================
# Operational Settings
# =========================================================================
LOG_LEVEL=INFO
